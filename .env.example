# Backend environment (set in backend/.env)
# FRONTEND_URL=https://www.edlernity.com
# APPLICATION_URL=https://www.edlernity.com
# CRM_URL=https://portal.edlernity.com
# CORS_ORIGINS=https://www.edlernity.com,https://edlernity.com,https://portal.edlernity.com

# Main React app (set when building www.edlernity.com)
REACT_APP_BACKEND_URL=http://localhost:5001/api/v1
REACT_APP_CRM_URL=http://localhost:3001
# Production build should use:
# REACT_APP_BACKEND_URL=https://YOUR-API-HOST/api/v1
# REACT_APP_CRM_URL=https://portal.edlernity.com

# CRM Next.js (portal.edlernity.com)
# NEXT_PUBLIC_BACKEND_URL=https://YOUR-API-HOST
# NEXT_PUBLIC_CRM_URL=https://portal.edlernity.com
# NEXT_PUBLIC_LEARNER_URL=https://www.edlernity.com
# ADMIN_EMAILS promotes listed emails to admin only when their stored role is student.
# Explicit manager/trainer/admin roles in the database are not overridden.
# ADMIN_EMAILS=ishu.kumar0007@gmail.com
# MONGODB_URI=
# JWT_SECRET=
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
# GROQ_API_KEY=
